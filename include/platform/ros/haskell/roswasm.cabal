cabal-version: 3.0
name: roswasm
version: 0.1.0.0
synopsis: Bounded ROS Guest source SDK for the wasm32-wasi GHC cross compiler
license: Apache-2.0
build-type: Simple

flag ros1
  description: Select only the original ROS1 numeric imports
  default: False
  manual: True
flag ros2
  description: Select only the original ROS2 numeric imports
  default: False
  manual: True

library
  exposed-modules: RosWasm, RosWasm.Raw, RosWasm.Wire, RosWasm.Typed
  hs-source-dirs: src
  build-depends: base >=4.18 && <5, bytestring >=0.11 && <0.13, text >=2.0 && <2.2
  default-language: Haskell2010
  ghc-options: -Wall
  c-sources: ../../../../src/platform/ros/c_ffi_bridge/shim.c
  include-dirs: ../native_languages
  if flag(ros1) && !flag(ros2)
    cc-options: -DROSWASM_C_FFI_BACKEND=1
  else
    if flag(ros2) && !flag(ros1)
      cc-options: -DROSWASM_C_FFI_BACKEND=2
    else
      buildable: False

{
  "format": "uwvm-ros-binding-v1",
  "language": "d",
  "extensions": [
    ".d"
  ],
  "abi": {
    "ros2": "uwvm_ros2_v1"
  },
  "module_roots": [
    "include/platform",
    "include/platform/yaskawa/d"
  ],
  "native_sources": {},
  "catalogs": {
    "ros2": "share/platform/yaskawa/catalogs/ros2/catalog.preparation.json"
  },
  "records_ir": "share/platform/yaskawa/records-ir.json",
  "original_complete_source_fields_retained": true,
  "native_action": {
    "format": "uwvm-native-action-v1",
    "language": "d",
    "c_sources": [
      {
        "source": "src/language/native/abi.c",
        "object": "abi.o",
        "defines": [
          "UWVM_NATIVE_ROS2"
        ]
      }
    ],
    "d": {
      "import_dirs": [
        "src/language"
      ],
      "modules": [
        "native.d.wire",
        "native.d.observation",
        "ros.d.wire",
        "yaskawa.d.ros2.records",
        "yaskawa.d.ros2.observation"
      ]
    }
  }
}

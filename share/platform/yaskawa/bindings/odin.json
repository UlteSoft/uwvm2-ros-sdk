{
  "format": "uwvm-ros-binding-v1",
  "language": "odin",
  "extensions": [
    ".odin"
  ],
  "abi": {
    "ros2": "uwvm_ros2_v1"
  },
  "module_roots": [
    "include/platform",
    "include/platform/yaskawa/odin"
  ],
  "native_sources": {},
  "catalogs": {
    "ros2": "share/platform/yaskawa/catalogs/ros2/catalog.preparation.json"
  },
  "records_ir": "share/platform/yaskawa/records-ir.json",
  "original_complete_source_fields_retained": true,
  "native_action": {
    "format": "uwvm-native-action-v1",
    "language": "odin",
    "c_sources": [
      {
        "source": "src/language/native/abi.c",
        "object": "abi.o",
        "defines": [
          "UWVM_NATIVE_ROS2"
        ]
      }
    ],
    "odin": {
      "collections": [
        {
          "name": "yaskawa",
          "directory": "include/platform/yaskawa"
        },
        {
          "name": "ros",
          "directory": "include/platform/ros"
        },
        {
          "name": "native",
          "directory": "src/language/native"
        }
      ]
    }
  }
}

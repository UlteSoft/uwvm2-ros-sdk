{
  "format": "uwvm-vendor-release-binding-v1",
  "platform": "kinova",
  "language": "zig",
  "profile": "ros2_humble",
  "backend": "ros2",
  "source_root": "include/platform/kinova/zig/ros2/mobile-fjt-humble-complete",
  "include_root": "include/platform",
  "default_authority": [],
  "native_action": {
    "format": "uwvm-native-action-v1",
    "language": "zig",
    "zig": {
      "wasi": true,
      "imports": [
        "kinova_records"
      ],
      "modules": [
        {
          "name": "roswire",
          "source": "include/platform/ros/zig/wire.zig"
        },
        {
          "name": "kinova_records",
          "source": "include/platform/kinova/zig/ros2/mobile-fjt-humble-complete/records.zig",
          "imports": [
            "roswire"
          ]
        }
      ]
    },
    "c_sources": [
      "src/language/native/startup.c"
    ]
  }
}

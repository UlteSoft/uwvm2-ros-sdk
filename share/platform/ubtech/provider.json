          {
            "name": "roswasm/wire",
            "path": "include/platform/ros/lua/roswasm/wire.lua"
          },
          {
            "name": "ubtech/lua/ros2/main/records",
            "path": "include/platform/ubtech/lua/ros2/main/records.lua"
          }
        ],
        "r": [
          {
            "name": "roswasm/wire",
            "path": "include/platform/ros/r/roswasm/wire.R"
          },
          {
            "name": "uwvm/r/native",
            "path": "src/language/r/native.R"
          },
          {
            "name": "ubtech/r/ros2/main/records",
            "path": "include/platform/ubtech/r/ros2/main/records.R"
          },
          {
            "name": "uwvm/r/observation",
            "path": "src/language/r/observation.R"
          }
        ]
      },
      "source_only": true,
      "native_identity_qualification_required": true,
      "bindings": {
        "go": {
          "module": "ubtech/go/ros2/main",
          "root": "include/platform/ubtech/go/ros2/ubtech-ros2-main-complete",
          "shared_module": "uwvm2.local/roswasmgo",
          "backend_tag": "ros2",
          "complete_original_records": 8
        },
        "tinygo": {
          "module": "ubtech/tinygo/ros2/main",
          "root": "include/platform/ubtech/tinygo/ros2/ubtech-ros2-main-complete",
          "shared_module": "uwvm2.local/roswasm",
          "backend_tag": "ros2",
          "complete_original_records": 8
        },
        "d": {
          "module": "ubtech.d.ros2.main.records",
          "source": "include/platform/ubtech/d/ros2/main/records.d",
          "shared_imports": [
            "roswasm",
            "roswasm.wire"
          ],
          "producer": "one shared genuine D/BetterC compiler; consumer integration pending",
          "extra_sources": []
        }
      }
    }
  }
}

{
  "format": "uwvm-ros-provider-v1",
  "api_version": 1,
  "id": "ubtech",
  "module": "tools/platform/ubtech/provider.lua",
  "backends": {
    "ros2": {
      "distributions": [
        "humble",
        "jazzy"
      ]
    }
  },
  "languages": [
    "as",
    "c",
    "c_ffi_bridge",
    "cpp",
    "csharp",
    "d",
    "fsharp",
    "go",
    "haskell",
    "java",
    "js",
    "kotlin",
    "lua",
    "moonbit",
    "nim",
    "objectc",
    "odin",
    "php",
    "py",
    "r",
    "rs",
    "ruby",
    "swift",
    "tinygo",
    "vbnet",
    "zig"
  ],
  "targets": [
    "wasm32-wasip1",
    "wasm64-wasip1"
  ],
  "features": [
    "memory64",
    "table64",
    "simd128",
    "bulk-memory",
    "exceptions"
  ],
  "options": {},
  "scenarios_restricted": false,
  "qualification": "Configuration routes only; exact producer and runtime acceptance remain separate.",
  "platform": "ubtech",
  "default_authority": [],
  "profiles": {
    "ros2_main": {
      "backend": "ros2",
      "distributions": [
        "humble",
        "jazzy"
      ],
      "source_family": "ubtech-ros2-main-complete",
      "records": 8,
      "interfaces": 8,
      "modules": {
        "ruby": [
          {
            "name": "roswasm/wire",
            "path": "include/platform/ros/ruby/roswasm/wire.rb"
          },
          {
            "name": "roswasm/transport",
            "path": "include/platform/ros/ruby/roswasm/transport.rb"
          },
          {
            "name": "ubtech/ruby/ros2/main/records",
            "path": "include/platform/ubtech/ruby/ros2/main/records.rb"
          },
          {
            "name": "uwvm/ruby/observation",
            "path": "src/language/ruby/observation.rb"
          }
        ],
        "php": [
          {
            "name": "RosWasm/Word",
            "path": "include/platform/ros/php/RosWasm/Word.php"
          },
          {
            "name": "RosWasm/Wire",
            "path": "include/platform/ros/php/RosWasm/Wire.php"
          },
          {
            "name": "RosWasm/Transport",
            "path": "include/platform/ros/php/RosWasm/Transport.php"
          },
          {
            "name": "ubtech/php/ros2/main/records",
            "path": "include/platform/ubtech/php/ros2/main/records.php"
          },
          {
            "name": "uwvm/php/observation",
            "path": "src/language/php/Observation.php"
          }
        ],
        "py": [
          {
            "name": "ros",
            "path": "include/platform/ros/py/ros/__init__.py",
            "package": true
          },
          {
            "name": "ros.py",
            "path": "include/platform/ros/py/ros/py/__init__.py",
            "package": true
          },
          {
            "name": "ros.py.wire",
            "path": "include/platform/ros/py/ros/py/wire.py"
          },
          {
            "name": "ros.py.transport",
            "path": "include/platform/ros/py/ros/py/transport.py"
          },
          {
            "name": "ubtech",
            "path": "include/platform/ubtech/__init__.py",
            "package": true
          },
          {
            "name": "ubtech.py",
            "path": "include/platform/ubtech/py/__init__.py",
            "package": true
          },
          {
            "name": "ubtech.py.ros2",
            "path": "include/platform/ubtech/py/ros2/__init__.py",
            "package": true
          },
          {
            "name": "ubtech.py.ros2.main",
            "path": "include/platform/ubtech/py/ros2/main/__init__.py",
            "package": true
          },
          {
            "name": "ubtech.py.ros2.main.records",
            "path": "include/platform/ubtech/py/ros2/main/records.py"
          }
        ],
        "js": [
          {
            "name": "ros/js/wire",
            "path": "include/platform/ros/js/wire.mjs"
          },
          {
            "name": "ros/js/transport",
            "path": "include/platform/ros/js/transport.mjs"
          },
          {
            "name": "ubtech/js/ros2/main/records",
            "path": "include/platform/ubtech/js/ros2/main/records.mjs"
          }
        ],

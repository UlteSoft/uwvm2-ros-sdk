    "include/platform",
    "include/platform/ros/swift",
    "include/platform/ros/swift/Sources"
  ],
  "native_definitions": {
    "ros1": [
      "UWVM_NATIVE_ROS1=1"
    ],
    "ros2": [
      "UWVM_NATIVE_ROS2=1"
    ]
  },
  "native_sources": {
    "ros1": [

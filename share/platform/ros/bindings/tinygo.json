{
  "abi": {
    "ros1": "uwvm_ros1_v1",
    "ros2": "uwvm_ros2_v1"
  },
  "backend_features": {
    "ros1": [
      "ros1"
    ],
    "ros2": [
      "ros2"
    ]
  },
  "backend_roots": {
    "ros1": "include/platform/ros1/tinygo",
    "ros2": "include/platform/ros2/tinygo"
  },
  "extensions": [
    ".go"
  ],
  "format": "uwvm-ros-binding-v1",
  "language": "tinygo",
  "module_file": "include/platform/ros/tinygo/go.mod",
  "module_roots": [
    "include/platform",
    "include/platform/ros/tinygo"
  ],
  "native_sources": {},
  "operations": {
    "call_trigger": {
      "operation": "service.call",
      "types": {
        "ros1": "std_srvs/Trigger",
        "ros2": "std_srvs/srv/Trigger"
      }
    },
    "publish_string": {
      "operation": "topic.publish",
      "types": {
        "ros1": "std_msgs/String",
        "ros2": "std_msgs/msg/String"
      }
    },
    "subscribe_string": {
      "operation": "topic.subscribe",
      "types": {
        "ros1": "std_msgs/String",
        "ros2": "std_msgs/msg/String"
      }
    }
  },
  "request_contract": "share/platform/ros/adapter-contract.json"
}

{
  "abi": {
    "ros1": "uwvm_ros1_v1",
    "ros2": "uwvm_ros2_v1"
  },
  "backend_features": {
    "ros1": [
      "ros1",
      "alloc"
    ],
    "ros2": [
      "ros2",
      "alloc"
    ]
  },
  "backend_roots": {
    "ros1": "include/platform/ros1/rs",
    "ros2": "include/platform/ros2/rs"
  },
  "extensions": [
    ".rs"
  ],
  "features": [
    "alloc"
  ],
  "format": "uwvm-ros-binding-v1",
  "language": "rs",
  "library_sources": {
    "ros_native_command": "include/platform/ros/rs/native_command/lib.rs",
    "roswasm": "include/platform/ros/rs/src/lib.rs"
  },
  "module_roots": [
    "include/platform",
    "include/platform/ros/rs"
  ],
  "native_sources": {},
  "operations": {
    "call_trigger": {
      "operation": "service.call",
      "types": {
        "ros1": "std_srvs/Trigger",
        "ros2": "std_srvs/srv/Trigger"
      }
    },
    "publish_string": {
      "operation": "topic.publish",
      "types": {
        "ros1": "std_msgs/String",
        "ros2": "std_msgs/msg/String"
      }
    },
    "subscribe_string": {
      "operation": "topic.subscribe",
      "types": {
        "ros1": "std_msgs/String",
        "ros2": "std_msgs/msg/String"
      }
    }
  },
  "request_contract": "share/platform/ros/adapter-contract.json"
}

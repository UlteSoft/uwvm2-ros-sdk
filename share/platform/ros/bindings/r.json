{
  "abi": {
    "ros1": "uwvm_ros1_v1",
    "ros2": "uwvm_ros2_v1"
  },
  "backend_roots": {
    "ros1": "include/platform/ros1/r",
    "ros2": "include/platform/ros2/r"
  },
  "extensions": [
    ".R",
    ".r"
  ],
  "format": "uwvm-ros-binding-v1",
  "language": "r",
  "module_files": [
    "ros/r/roswasm/wire.R",
    "ros/r/roswasm/native_command.R"
  ],
  "module_roots": [
    "include/platform",
    "include/platform/ros/r"
  ],
  "native_definitions": {
    "ros1": [
      "UWVM_ROS1=1"
    ],
    "ros2": [
      "UWVM_ROS2=1"
    ]
  },
  "native_sources": {
    "ros1": [
      "src/platform/ros/r/bridge.c"
    ],
    "ros2": [
      "src/platform/ros/r/bridge.c"
    ]
  },
  "operations": {
    "call_trigger": {
      "operation": "service.call",
      "types": {
        "ros1": "std_srvs/Trigger",
        "ros2": "std_srvs/srv/Trigger"
      }
    },
    "publish_string": {
      "operation": "topic.publish",
      "types": {
        "ros1": "std_msgs/String",
        "ros2": "std_msgs/msg/String"
      }
    },
    "subscribe_string": {
      "operation": "topic.subscribe",
      "types": {
        "ros1": "std_msgs/String",
        "ros2": "std_msgs/msg/String"
      }
    }
  },
  "package": {
    "exports": [
      "roswasm_wire",
      "ros_native_command"
    ],
    "name": "uwvmros",
    "native_registration": "uwvm_ros_r_register",
    "native_routine": "uwvm_ros_invoke",
    "requires": "genuine upstream R with embedded source packages and registered .Call routines"
  },
  "request_contract": "share/platform/ros/adapter-contract.json"
}

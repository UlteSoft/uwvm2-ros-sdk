{
  "format": "uwvm-ros-binding-v1",
  "language": "rs",
  "extensions": [
    ".rs"
  ],
  "abi": {
    "ros2": "uwvm_ros2_v1"
  },
  "module_roots": [
    "include/platform",
    "include/platform/fanuc/rs"
  ],
  "native_sources": {},
  "catalogs": {
    "ros2": "share/platform/fanuc/catalogs/ros2/catalog.preparation.json"
  },
  "records_ir": "share/platform/fanuc/records-ir.json",
  "original_complete_source_fields_retained": true,
  "native_action": {
    "format": "uwvm-native-action-v1",
    "language": "rs",
    "rust": {
      "cfg": [
        "feature=\"alloc\"",
        "feature=\"ros2\""
      ],
      "crates": [
        {
          "name": "roswasm",
          "source": "include/platform/ros/rs/src/lib.rs",
          "dependencies": []
        },
        {
          "name": "fanuc_records",
          "source": "include/platform/fanuc/rs/ros2/fanuc-ros2-complete/bounded_records.rs",
          "dependencies": [
            "roswasm"
          ]
        }
      ],
      "imports": [
        "roswasm",
        "fanuc_records"
      ]
    }
  }
}

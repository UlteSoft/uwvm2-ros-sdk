{
  "format": "uwvm-ros-binding-v1",
  "language": "swift",
  "extensions": [
    ".swift"
  ],
  "abi": {
    "ros2": "uwvm_ros2_v1"
  },
  "module_roots": [
    "include/platform",
    "include/platform/fanuc/swift"
  ],
  "native_sources": {},
  "catalogs": {
    "ros2": "share/platform/fanuc/catalogs/ros2/catalog.preparation.json"
  },
  "records_ir": "share/platform/fanuc/records-ir.json",
  "original_complete_source_fields_retained": true,
  "native_action": {
    "format": "uwvm-native-action-v1",
    "language": "swift",
    "swift": {
      "module_name": "FanucCommand",
      "bridging_header": "include/language/native/abi.h",
      "sources": [
        "src/language/native/swift/Wire.swift",
        "src/language/native/swift/CoreObservation.swift",
        "include/platform/fanuc/swift/ros2/Records.swift",
        "include/platform/fanuc/swift/ros2/Observation.swift"
      ]
    },
    "c_sources": [
      {
        "source": "src/language/native/abi.c",
        "defines": [
          "UWVM_NATIVE_POINTER_BITS=32",
          "UWVM_NATIVE_ROS2"
        ]
      }
    ]
  }
}

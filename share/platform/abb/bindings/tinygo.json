{
  "format": "uwvm-ros-binding-v1",
  "language": "tinygo",
  "extensions": [
    ".go"
  ],
  "abi": {
    "ros1": "uwvm_ros1_v1",
    "ros2": "uwvm_ros2_v1"
  },
  "module_roots": [
    "include/platform",
    "include/platform/abb/tinygo"
  ],
  "native_sources": {},
  "catalogs": {
    "ros1": "share/platform/abb/catalogs/ros1/catalog.preparation.json",
    "ros2": "share/platform/abb/catalogs/ros2/catalog.preparation.json"
  },
  "records_ir": "share/platform/abb/records-ir.json",
  "original_complete_source_fields_retained": true,
  "native_actions": {
    "ros1": {
      "format": "uwvm-native-action-v1",
      "language": "tinygo",
      "go": {
        "modules": [
          "include/platform/ros/tinygo",
          "include/platform/abb/tinygo/ros1/abb-ros1-complete"
        ],
        "tags": [
          "ros1"
        ]
      }
    },
    "ros2": {
      "format": "uwvm-native-action-v1",
      "language": "tinygo",
      "go": {
        "modules": [
          "include/platform/ros/tinygo",
          "include/platform/abb/tinygo/ros2/abb-ros2-complete",
          "include/platform/abb/tinygo/observation"
        ],
        "tags": [
          "ros2"
        ]
      }
    }
  }
}

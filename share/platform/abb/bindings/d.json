{
  "format": "uwvm-ros-binding-v1",
  "language": "d",
  "extensions": [
    ".d"
  ],
  "abi": {
    "ros1": "uwvm_ros1_v1",
    "ros2": "uwvm_ros2_v1"
  },
  "module_roots": [
    "include/platform",
    "include/platform/abb/d"
  ],
  "native_sources": {},
  "catalogs": {
    "ros1": "share/platform/abb/catalogs/ros1/catalog.preparation.json",
    "ros2": "share/platform/abb/catalogs/ros2/catalog.preparation.json"
  },
  "records_ir": "share/platform/abb/records-ir.json",
  "original_complete_source_fields_retained": true,
  "native_actions": {
    "ros1": {
      "format": "uwvm-native-action-v1",
      "language": "d",
      "c_sources": [
        {
          "source": "src/language/native/abi.c",
          "object": "abi.o",
          "defines": [
            "UWVM_NATIVE_ROS1"
          ]
        }
      ],
      "d": {
        "import_dirs": [
          "src/language"
        ],
        "modules": [
          "native.d.wire",
          "native.d.observation",
          "ros.d.wire",
          "abb.d.ros1.records",
          "abb.d.ros1.observation"
        ]
      }
    },
    "ros2": {
      "format": "uwvm-native-action-v1",
      "language": "d",
      "c_sources": [
        {
          "source": "src/platform/ros/native_sources/abi.c",
          "object": "abi.o",
          "defines": [
            "UWVM_NATIVE_ROS2"
          ]
        }
      ],
      "d": {
        "import_dirs": [
          "src/language"
        ],
        "modules": [
          "abb.d.observation"
        ]
      }
    }
  }
}

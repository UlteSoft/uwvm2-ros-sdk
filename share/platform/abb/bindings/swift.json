{
  "format": "uwvm-ros-binding-v1",
  "language": "swift",
  "extensions": [
    ".swift"
  ],
  "abi": {
    "ros1": "uwvm_ros1_v1",
    "ros2": "uwvm_ros2_v1"
  },
  "module_roots": [
    "include/platform",
    "include/platform/abb/swift"
  ],
  "native_sources": {},
  "catalogs": {
    "ros1": "share/platform/abb/catalogs/ros1/catalog.preparation.json",
    "ros2": "share/platform/abb/catalogs/ros2/catalog.preparation.json"
  },
  "records_ir": "share/platform/abb/records-ir.json",
  "original_complete_source_fields_retained": true,
  "native_actions": {
    "ros1": {
      "format": "uwvm-native-action-v1",
      "language": "swift",
      "swift": {
        "module_name": "AbbCommand",
        "bridging_header": "include/language/native/abi.h",
        "sources": [
          "src/language/native/swift/Wire.swift",
          "src/language/native/swift/CoreObservation.swift",
          "include/platform/abb/swift/ros1/Records.swift",
          "include/platform/abb/swift/ros1/Observation.swift"
        ]
      },
      "c_sources": [
        {
          "source": "src/language/native/abi.c",
          "defines": [
            "UWVM_NATIVE_POINTER_BITS=32",
            "UWVM_NATIVE_ROS1"
          ]
        }
      ]
    },
    "ros2": {
      "format": "uwvm-native-action-v1",
      "language": "swift",
      "swift": {
        "module_name": "AbbCommand",
        "bridging_header": "include/language/native/abi.h",
        "sources": [
          "include/platform/abb/swift/Observation.swift"
        ]
      },
      "c_sources": [
        {
          "source": "src/language/native/abi.c",
          "defines": [
            "UWVM_NATIVE_POINTER_BITS=32",
            "UWVM_NATIVE_ROS2"
          ]
        }
      ]
    }
  }
}

{
  "format": "uwvm-ros-binding-v1",
  "language": "zig",
  "extensions": [
    ".zig"
  ],
  "abi": {
    "ros1": "uwvm_ros1_v1",
    "ros2": "uwvm_ros2_v1"
  },
  "module_roots": [
    "include/platform",
    "include/platform/abb/zig"
  ],
  "native_sources": {},
  "catalogs": {
    "ros1": "share/platform/abb/catalogs/ros1/catalog.preparation.json",
    "ros2": "share/platform/abb/catalogs/ros2/catalog.preparation.json"
  },
  "records_ir": "share/platform/abb/records-ir.json",
  "original_complete_source_fields_retained": true,
  "native_actions": {
    "ros1": {
      "format": "uwvm-native-action-v1",
      "language": "zig",
      "c_sources": [
        {
          "source": "src/language/native/abi.c",
          "object": "abi.o",
          "defines": [
            "UWVM_NATIVE_ROS1"
          ]
        }
      ],
      "zig": {
        "wasi": true,
        "imports": [
          "abb"
        ],
        "modules": [
          {
            "name": "native_wire",
            "source": "src/language/native/zig/wire.zig"
          },
          {
            "name": "roswire",
            "source": "include/platform/ros/zig/wire.zig"
          },
          {
            "name": "ros_observation",
            "source": "src/language/native/zig/observation.zig",
            "imports": [
              "native_wire"
            ]
          },
          {
            "name": "abb_records",
            "source": "include/platform/abb/zig/ros1/records.zig",
            "imports": [
              "roswire"
            ]
          },
          {
            "name": "abb",
            "source": "include/platform/abb/zig/ros1/observation.zig",
            "imports": [
              "ros_observation",
              "abb_records"
            ]
          }
        ]
      }
    },
    "ros2": {
      "format": "uwvm-native-action-v1",
      "language": "zig",
      "c_sources": [
        {
          "source": "src/platform/ros/native_sources/abi.c",
          "object": "abi.o",
          "defines": [
            "UWVM_NATIVE_ROS2"
          ]
        }
      ],
      "zig": {
        "wasi": true,
        "imports": [
          "abb"
        ],
        "modules": [
          {
            "name": "abb",
            "source": "include/platform/abb/zig/observation.zig"
          }
        ]
      }
    }
  }
}

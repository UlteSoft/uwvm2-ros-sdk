              "resource": "/uwvmros/go2_stand/steady",
              "type": "builtin/time-v1",
              "identity": "builtin:time-nanoseconds-v1",
              "limits": {
                "max-rate-hz": "2000",
                "burst": "64",
                "max-bytes-per-second": "16000",
                "audit": "allow-and-deny",
                "audit-max-rate-hz": "1000",
                "audit-burst": "128",
                "audit-max-records": "10000",
                "audit-max-bytes": "1048576",
                "max-response-bytes": "8",
                "max-inflight": "1"
              }
            },
            {
              "alias": "unitree-go2-cancel",
              "operation": "topic.subscribe",
              "resource": "/uwvmros/go2_stand/cancel",
              "type": "std_msgs/msg/Bool",
              "identity": "RIHS01_feb91e995ff9ebd09c0cb3d2aed18b11077585839fb5db80193b62d74528f6c9",
              "limits": {

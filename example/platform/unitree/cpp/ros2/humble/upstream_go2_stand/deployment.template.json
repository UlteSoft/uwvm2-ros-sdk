                "qos.liveliness": "automatic",
                "qos.liveliness-lease-duration": "infinite"
              }
            }
          ],
          "wasi_grants": [
            "monotonic-clock"
          ],
          "call_boundary": "same-module"
        }
      }
    }
  }
}

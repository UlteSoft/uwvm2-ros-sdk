  "cases": [
    {
      "id": "sample",
      "arguments": [
        "0000003e000080be0000003f"
      ],
      "expected_exit": 0,
      "expected_json": {
        "type": "unitree_legged_msgs/Cartesian",
        "bytes": 12,
        "checked_fields": 3,
        "nondefault_fields": 3,
        "fields": {
          "x": 0.125,
          "y": -0.25,
          "z": 0.5
        },
        "hex": "0000003e000080be0000003f"
      }
    },
    {
      "id": "zeros",
      "arguments": [
        "000000000000000000000000"
      ],
      "expected_exit": 0,
      "expected_json": {
        "type": "unitree_legged_msgs/Cartesian",
        "bytes": 12,
        "checked_fields": 3,
        "nondefault_fields": 0,
        "fields": {
          "x": 0.0,
          "y": 0.0,
          "z": 0.0
        },
        "hex": "000000000000000000000000"
      }
    },
    {
      "id": "mixed",
      "arguments": [
        "000040c000000040000080bf"
      ],
      "expected_exit": 0,
      "expected_json": {
        "type": "unitree_legged_msgs/Cartesian",
        "bytes": 12,
        "checked_fields": 3,
        "nondefault_fields": 3,
        "fields": {
          "x": -3.0,
          "y": 2.0,
          "z": -1.0
        },
        "hex": "000040c000000040000080bf"
      }
    },
    {
      "id": "truncated",
      "arguments": [
        "0000003e000080be000000"
      ],
      "expected_exit": 22,
      "expected_stdout": "RangeError: hex frame has an invalid character or byte extent\n"
    },
    {
      "id": "trailing",
      "arguments": [
        "0000003e000080be0000003f00"
      ],
      "expected_exit": 22,
      "expected_stdout": "RangeError: hex frame has an invalid character or byte extent\n"
    },
    {
      "id": "nonhex",
      "arguments": [
        "zzzzzzzzzzzzzzzzzzzzzzzz"
      ],
      "expected_exit": 22,
      "expected_stdout": "RangeError: hex frame has an invalid character or byte extent\n"
    },
    {
      "id": "odd",
      "arguments": [
        "0"
      ],
      "expected_exit": 22,
      "expected_stdout": "RangeError: hex frame has an invalid character or byte extent\n"
    }
  ]
}

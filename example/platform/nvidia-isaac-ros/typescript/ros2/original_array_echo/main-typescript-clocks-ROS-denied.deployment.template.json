{
  "format": "uwvm-native-ros-run-v4",
  "backend": "ros2",
  "distribution": "jazzy",
  "runtime": "/absolute/native/uwvm2-ros-original-array",
  "gateway": "/absolute/native/uwvm-ros2-gateway-original-array",
  "connection": {
    "node-name": "nvidia_array_gateway",
    "namespace": "/sdk_fixture",
    "domain-id": "137",
    "rmw-implementation": "rmw_fastrtps_cpp",
    "security-mode": "disabled-test",
    "keystore": "not-applicable",
    "enclave": "not-applicable"
  },
  "runtime_features": [],
  "execution_timeout_seconds": 60,
  "examples": {
    "original_array_echo": {
      "arguments": [
        "sample",
        "outgoing"
      ],
      "main_module": "main",
      "preloads": [],
      "modules": {
        "main": {
          "ros_enabled": true,
          "grants": [],
          "wasi_grants": [
            "realtime-clock",
            "monotonic-clock"
          ],
          "connection": {
            "node-name": "nvidia_array_gateway",
            "namespace": "/sdk_fixture",
            "domain-id": "137",
            "rmw-implementation": "rmw_fastrtps_cpp",
            "security-mode": "disabled-test",
            "keystore": "not-applicable",
            "enclave": "not-applicable"
          },
          "worker_limits": {
            "connect-timeout-ms": "5000",
            "audit-deny-max-rate-hz": "100",
            "audit-deny-burst": "100",
            "audit-deny-max-records": "10000",
            "audit-deny-max-bytes": "1048576"
          },
          "gateway_limits": {
            "timeout-ms": "10000",
            "max-sessions": "16",
            "audit-max-records-per-second": "100",
            "audit-max-records": "10000",
            "audit-max-bytes": "1048576"
          },
          "call_boundary": "same-module",
          "wasi_enabled": true,
          "wasi_interfaces": {
            "args_get": "allow",
            "args_sizes_get": "allow",
            "clock_time_get": "allow",
            "fd_close": "allow",
            "fd_fdstat_get": "allow",
            "fd_read": "allow",
            "fd_seek": "allow",
            "fd_write": "allow",
            "poll_oneoff": "allow",
            "proc_exit": "allow"
          },
          "ros_interfaces": {
            "uwvm_ros2_v1.abi_version": "allow",
            "uwvm_ros2_v1.action_advertise": "allow",
            "uwvm_ros2_v1.action_cancel_any_goal": "allow",
            "uwvm_ros2_v1.action_cancel_own_goal": "allow",
            "uwvm_ros2_v1.action_receive_feedback": "allow",
            "uwvm_ros2_v1.action_receive_result": "allow",
            "uwvm_ros2_v1.action_respond": "allow",
            "uwvm_ros2_v1.action_send_goal": "allow",
            "uwvm_ros2_v1.capability_close": "allow",
            "uwvm_ros2_v1.capability_open": "allow",
            "uwvm_ros2_v1.capability_revoke": "allow",
            "uwvm_ros2_v1.event_poll": "allow",
            "uwvm_ros2_v1.event_poll_v1": "allow",
            "uwvm_ros2_v1.event_ready": "allow",
            "uwvm_ros2_v1.event_watch": "allow",
            "uwvm_ros2_v1.graph_inspect_action": "allow",
            "uwvm_ros2_v1.graph_inspect_node": "allow",
            "uwvm_ros2_v1.graph_inspect_service": "allow",
            "uwvm_ros2_v1.graph_inspect_topic": "allow",
            "uwvm_ros2_v1.graph_list_nodes": "allow",
            "uwvm_ros2_v1.graph_list_services": "allow",
            "uwvm_ros2_v1.graph_list_topics": "allow",
            "uwvm_ros2_v1.lifecycle_change_state": "allow",
            "uwvm_ros2_v1.lifecycle_get_state": "allow",
            "uwvm_ros2_v1.log_write": "allow",
            "uwvm_ros2_v1.parameter_declare": "allow",
            "uwvm_ros2_v1.parameter_describe": "allow",
            "uwvm_ros2_v1.parameter_get": "allow",
            "uwvm_ros2_v1.parameter_list": "allow",
            "uwvm_ros2_v1.parameter_set": "allow",
            "uwvm_ros2_v1.parameter_subscribe_events": "allow",
            "uwvm_ros2_v1.parameter_undeclare": "allow",
            "uwvm_ros2_v1.service_advertise": "allow",
            "uwvm_ros2_v1.service_call": "allow",
            "uwvm_ros2_v1.service_respond": "allow",
            "uwvm_ros2_v1.service_submit": "allow",
            "uwvm_ros2_v1.tf_broadcast": "allow",
            "uwvm_ros2_v1.tf_lookup": "allow",
            "uwvm_ros2_v1.time_read_ros": "allow",
            "uwvm_ros2_v1.time_read_steady": "allow",
            "uwvm_ros2_v1.time_read_system": "allow",
            "uwvm_ros2_v1.topic_publish": "allow",
            "uwvm_ros2_v1.topic_subscribe": "allow"
          }
        }
      }
    }
  }
}

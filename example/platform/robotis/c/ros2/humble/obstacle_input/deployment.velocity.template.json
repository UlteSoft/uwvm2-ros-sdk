{
  "format": "uwvm-native-ros-run-v2",
  "runtime": "/opt/uwvm2-ros/bin/uwvm2-ros",
  "gateway": "/opt/uwvm2-ros/bin/uwvm-ros2-gateway",
  "backend": "ros2",
  "distribution": "humble",
  "connection": {
    "node-name": "uwvm_robotis_obstacle_velocity_input_gateway",
    "namespace": "/",
    "domain-id": "@ADMITTED_ROS_DOMAIN_ID@",
    "rmw-implementation": "rmw_cyclonedds_cpp",
    "security-mode": "disabled-test",
    "keystore": "not-applicable",
    "enclave": "not-applicable"
  },
  "execution_timeout_seconds": 60,
  "examples": {
    "obstacle_input": {
      "arguments": [
        "velocity",
        "0",
        "0",
        "0",
        "0",
        "0",
        "0"
      ],
      "main_module": "robotis_obstacle_input",
      "preloads": [],
      "modules": {
        "robotis_obstacle_input": {
          "ros_enabled": true,
          "grants": [
            {
              "alias": "robotis-obstacle-raw-input",
              "operation": "topic.publish",
              "resource": "/uwvmros/turtlebot3/obstacle/cmd_vel_raw",
              "type": "geometry_msgs/msg/Twist",
              "identity": "RIHS01_9c45bf16fe0983d80e3cfe750d6835843d265a9a6c46bd2e609fcddde6fb8d2a",
              "limits": {
                "max-rate-hz": "4000",
                "burst": "5",
                "max-bytes-per-second": "192000",
                "audit": "allow-and-deny",
                "audit-max-rate-hz": "1000",
                "audit-burst": "128",
                "audit-max-records": "10000",
                "audit-max-bytes": "1048576",
                "max-message-bytes": "48",
                "max-queue-bytes": "240",
                "overflow-policy": "drop-oldest",
                "validator": "none",
                "max-inflight": "1",
                "max-publishers": "1",
                "qos.reliability": "best-effort",
                "qos.durability": "volatile",
                "qos.history": "keep-last",
                "qos.depth": "5",
                "qos.deadline": "infinite",
                "qos.lifespan": "infinite",
                "qos.liveliness": "automatic",
                "qos.liveliness-lease-duration": "infinite"
              }
            }
          ],
          "wasi_grants": [],
          "call_boundary": "same-module"
        }
      }
    }
  }
}

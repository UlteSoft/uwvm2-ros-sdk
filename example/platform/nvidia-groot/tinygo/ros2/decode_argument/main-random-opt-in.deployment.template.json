{
  "format": "uwvm-native-ros-run-v4",
  "runtime": "PATH_TO_INSTALLED_UWVM2_ROS",
  "gateway": "PATH_TO_INSTALLED_UWVM_ROS2_GATEWAY",
  "backend": "ros2",
  "distribution": "jazzy",
  "connection": {
    "node-name": "nvidia_tinygo_cpu",
    "namespace": "/",
    "domain-id": "137",
    "rmw-implementation": "rmw_fastrtps_cpp",
    "security-mode": "disabled-test"
  },
  "execution_timeout_seconds": 30,
  "examples": {
    "decode_argument": {
      "arguments": [
        "050000007374617465010000000100000003000000030000000000b4400000d4400000f440"
      ],
      "main_module": "main",
      "preloads": [],
      "modules": {
        "main": {
          "ros_enabled": false,
          "grants": [],
          "wasi_grants": [
            "monotonic-clock",
            "random"
          ],
          "wasi_enabled": true,
          "wasi_interfaces": {
            "args_get": "allow",
            "args_sizes_get": "allow",
            "clock_time_get": "allow",
            "fd_write": "allow",
            "proc_exit": "allow",
            "random_get": "allow"
          },
          "ros_interfaces": {}
        }
      }
    }
  }
}

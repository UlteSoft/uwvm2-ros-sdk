  "id": "wasi-js-sum-arguments",
  "scope": "Complete original Wasm command execution with explicit standard-stream input and exact result assertions.",
  "cases": [
    {
      "id": "sum-normal",
      "arguments": [
        "19",
        "23"
      ],
      "expected_exit": 0,
      "expected_stdout": "42\n"
    },
    {
      "id": "sum-empty",
      "arguments": [],
      "expected_exit": 0,
      "expected_stdout": "0\n"
    },
    {
      "id": "sum-signed",
      "arguments": [
        "-41",
        "+42",
        "0"
      ],
      "expected_exit": 0,
      "expected_stdout": "1\n"
    },
    {
      "id": "sum-malformed",
      "arguments": [
        "12bad"
      ],
      "expected_exit": 22,
      "expected_stdout": ""
    },
    {
      "id": "sum-overflow",
      "arguments": [
        "2147483647",
        "1"
      ],
      "expected_exit": 22,
      "expected_stdout": ""
    },
    {
      "id": "sum-no-digits",
      "arguments": [
        "+"
      ],
      "expected_exit": 22,
      "expected_stdout": ""
    }
  ],

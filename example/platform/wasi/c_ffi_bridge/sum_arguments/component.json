      "expected_stdout": "0\n"
    },
    {
      "id": "sum-signed",
      "arguments": [
        "-41",
        "+42",
        "0"
      ],
      "expected_exit": 0,
      "expected_stdout": "1\n"
    },
    {
      "id": "sum-malformed",
      "arguments": [
        "12bad"
      ],
      "expected_exit": 22,
      "expected_stdout": ""
    },
    {
      "id": "sum-overflow",
      "arguments": [
        "2147483647",
        "1"
      ],
      "expected_exit": 22,
      "expected_stdout": ""
    },
    {
      "id": "sum-no-digits",
      "arguments": [

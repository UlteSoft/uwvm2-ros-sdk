(module
  (import "wasi_snapshot_preview1" "sock_send" (func $send (param i32 i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "sock_recv" (func $recv (param i32 i32 i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "sock_shutdown" (func $shutdown (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_fdstat_get" (func $fdstat (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_fdstat_set_rights" (func $rights (param i32 i64 i64) (result i32)))
  (import "wasi_snapshot_preview1" "proc_exit" (func $exit (param i32)))
  (memory (export "memory") 1)
  (data (i32.const 128) "socket-payload!")
  (func $ok (param $errno i32)
    (if (local.get $errno) (then (call $exit (local.get $errno)))))
  (func (export "_start")
    ;; The descriptor exposes only its real type, logical flags, and granted rights.
    (i64.store (i32.const 32) (i64.const -1))
    (i64.store (i32.const 40) (i64.const -1))
    (i64.store (i32.const 48) (i64.const -1))
    (call $ok (call $fdstat (i32.const 3) (i32.const 32)))
    (if (i64.ne (i64.load (i32.const 32)) (i64.const 6)) (then (call $exit (i32.const 102))))
    (i32.store (i32.const 0) (i32.const 128))
    (i32.store (i32.const 4) (i32.const 15))
    (call $ok (call $send (i32.const 3) (i32.const 0) (i32.const 1) (i32.const 0) (i32.const 16)))
    (call $ok (call $recv (i32.const 3) (i32.const 0) (i32.const 1) (i32.const 2) (i32.const 16) (i32.const 20)))
    (if (i32.ne (i32.load (i32.const 16)) (i32.const 15)) (then (call $exit (i32.const 100))))
    (if (i32.ne (i32.load8_u (i32.const 135)) (i32.const 114)) (then (call $exit (i32.const 101))))
    (call $ok (call $shutdown (i32.const 3) (i32.const 2)))
    ;; A Guest may discard authority, but cannot restore it or acquire new rights.
    (call $ok (call $rights (i32.const 3) (i64.const 0) (i64.const 0)))
    (call $ok (call $fdstat (i32.const 3) (i32.const 32)))
    (if (i64.ne (i64.load (i32.const 40)) (i64.const 0)) (then (call $exit (i32.const 103))))
    (if (i64.ne (i64.load (i32.const 48)) (i64.const 0)) (then (call $exit (i32.const 104))))
    (if (i32.ne (call $rights (i32.const 3) (i64.const 64) (i64.const 0)) (i32.const 76)) (then (call $exit (i32.const 105))))
    (if (i32.ne (call $send (i32.const 3) (i32.const 0) (i32.const 1) (i32.const 0) (i32.const 16)) (i32.const 76)) (then (call $exit (i32.const 106))))))

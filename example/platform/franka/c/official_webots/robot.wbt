#VRML_SIM R2025a utf8
# Official model and physics are unchanged. This file composes the test scene.
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/franka_emika/panda/protos/Panda.proto"
WorldInfo { basicTimeStep 16 randomSeed 0 }
Viewpoint { orientation 0.12 0.48 0.87 2.6 position 4 4 3 }
Solid { translation 0 0 -0.05 children [ Shape { geometry Box { size 10 10 0.1 } } ] boundingObject Box { size 10 10 0.1 } }
Panda { name "official_franka" controller "<extern>"  }
Robot { name "Ros2Supervisor" controller "<extern>" supervisor TRUE }

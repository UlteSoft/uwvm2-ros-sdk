{
  "format": "uwvm-native-ros-run-v4",
  "runtime": "/opt/uwvm2-ros/bin/uwvm2-ros",
  "gateway": "/opt/uwvm2-ros/bin/uwvm-ros1-gateway",
  "backend": "ros1",
  "distribution": "noetic",
  "connection": {
    "master-uri": "http://127.0.0.1:11321",
    "node-name": "sdk_native_rpc_server",
    "namespace": "/sdk_fixture",
    "advertise-host": "127.0.0.1",
    "transport": "tcpros"
  },
  "runtime_features": [],
  "execution_timeout_seconds": 30,
  "examples": {
    "serve_native_joint_impedance": {
      "arguments": [
        "serve",
        "reply"
      ],
      "main_module": "main",
      "preloads": [],
      "modules": {
        "main": {
          "ros_enabled": true,
          "grants": [
            {
              "alias": "serve",
              "operation": "service.advertise",
              "resource": "/sdk_fixture/franka/served_joint_impedance",
              "type": "franka_msgs/SetJointImpedance",
              "identity": "f11c4defa2a13040512214f9d77dc982",
              "limits": {
                "max-rate-hz": "100",
                "burst": "10",
                "max-bytes-per-second": "1048576",
                "validator": "none",
                "audit": "allow-and-deny",
                "audit-max-rate-hz": "100",
                "audit-burst": "100",
                "audit-max-records": "10000",
                "audit-max-bytes": "1048576",
                "adapter-codec-identity": "UWVMROS1_adc5ca154fe552aa0d3a0d29e8054389187031cbe3d4f21f86ae7fa7b38be25a",
                "timeout-ms": "5000",
                "max-inflight": "1",
                "max-request-bytes": "56",
                "max-response-bytes": "261",
                "max-services": "1",
                "max-event-queue-depth": "10",
                "max-event-queue-bytes": "4096",
                "overflow-policy": "reject"
              }
            },
            {
              "alias": "reply",
              "operation": "service.respond",
              "resource": "/sdk_fixture/franka/served_joint_impedance",
              "type": "franka_msgs/SetJointImpedance",
              "identity": "f11c4defa2a13040512214f9d77dc982",
              "limits": {
                "max-rate-hz": "100",
                "burst": "10",
                "max-bytes-per-second": "1048576",
                "validator": "none",
                "audit": "allow-and-deny",
                "audit-max-rate-hz": "100",
                "audit-burst": "100",
                "audit-max-records": "10000",
                "audit-max-bytes": "1048576",
                "adapter-codec-identity": "UWVMROS1_adc5ca154fe552aa0d3a0d29e8054389187031cbe3d4f21f86ae7fa7b38be25a",
                "timeout-ms": "5000",
                "max-inflight": "1",
                "max-request-bytes": "56",
                "max-response-bytes": "261"
              }
            }
          ],
          "wasi_grants": [
            "monotonic-clock"
          ],
          "wasi_enabled": true,
          "wasi_interfaces": {
            "args_get": "allow",
            "args_sizes_get": "allow",
            "fd_close": "allow",
            "fd_fdstat_get": "allow",
            "fd_seek": "allow",
            "fd_write": "allow",
            "poll_oneoff": "allow",
            "proc_exit": "allow"
          },
          "ros_interfaces": {
            "uwvm_ros1_v1.abi_version": "allow",
            "uwvm_ros1_v1.action_advertise": "allow",
            "uwvm_ros1_v1.action_cancel_any_goal": "allow",
            "uwvm_ros1_v1.action_cancel_own_goal": "allow",
            "uwvm_ros1_v1.action_receive_feedback": "allow",
            "uwvm_ros1_v1.action_receive_result": "allow",
            "uwvm_ros1_v1.action_respond": "allow",
            "uwvm_ros1_v1.action_send_goal": "allow",
            "uwvm_ros1_v1.capability_close": "allow",
            "uwvm_ros1_v1.capability_open": "allow",
            "uwvm_ros1_v1.capability_revoke": "allow",
            "uwvm_ros1_v1.event_poll": "allow",
            "uwvm_ros1_v1.graph_inspect_node": "allow",
            "uwvm_ros1_v1.graph_inspect_service": "allow",
            "uwvm_ros1_v1.graph_inspect_topic": "allow",
            "uwvm_ros1_v1.graph_list_nodes": "allow",
            "uwvm_ros1_v1.graph_list_services": "allow",
            "uwvm_ros1_v1.graph_list_topics": "allow",
            "uwvm_ros1_v1.log_write": "allow",
            "uwvm_ros1_v1.parameter_delete": "allow",
            "uwvm_ros1_v1.parameter_exists": "allow",
            "uwvm_ros1_v1.parameter_get": "allow",
            "uwvm_ros1_v1.parameter_list": "allow",
            "uwvm_ros1_v1.parameter_search": "allow",
            "uwvm_ros1_v1.parameter_set": "allow",
            "uwvm_ros1_v1.service_advertise": "allow",
            "uwvm_ros1_v1.service_call": "allow",
            "uwvm_ros1_v1.service_respond": "allow",
            "uwvm_ros1_v1.tf_broadcast": "allow",
            "uwvm_ros1_v1.tf_lookup": "allow",
            "uwvm_ros1_v1.time_read_ros": "allow",
            "uwvm_ros1_v1.time_read_wall": "allow",
            "uwvm_ros1_v1.topic_publish": "allow",
            "uwvm_ros1_v1.topic_subscribe": "allow"
          }
        }
      }
    }
  }
}

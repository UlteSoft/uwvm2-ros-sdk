    "xacro"
  ],
  "scenarios": [
    {
      "id": "unchanged_wasm_goal_result_fresh_state",
      "kind": "joint",
      "expected_vm_exit": 0,
      "deadline_seconds": 30,
      "expected_native_goals": 1,
      "expected_guest_state_copies": 2
    },
    {
      "id": "permission_denied_no_native_effect",
      "kind": "denied",
      "expected_vm_exit": 13,
      "deadline_seconds": 30,
      "expected_native_goals": 0,
      "expected_guest_state_copies": 0,
      "must_precede_all_native_endpoints": true
    },
    {
      "id": "stale_authority_reference",
      "kind": "joint",
      "expected_vm_exit": 110,
      "deadline_seconds": 30,
      "expected_native_goals": 0,
      "expected_guest_state_copies": 0,
      "scope": "Original combined reference-bundle mismatch; individual fields and open guest handles require separate qualification"
    },
    {
      "id": "native_disconnected_before_guest",
      "kind": "joint",
      "expected_vm_exit": 38,
      "deadline_seconds": 30,
      "expected_native_goals": 0,
      "expected_guest_state_copies": 0,
      "require_actual_matching_native_pid_disappeared_before_guest": true
    }
  ],
  "mandatory_additional_matrix": [
    "Independent authority-reference fields and actual expired/closed guest handles",
    "Two and three private component instances using the real SDK01/VM typed channel ABI",
    "Full Stage B and all original vendor/model/release/mode/language/library/ABI/architecture/security/debug/cache/update/performance rows",
    "Fresh reverse sensor/callback processing inside executing Wasm",
    "SDK10 final world-model scenario"
  ],

{
  "format": "uwvm-ros-command-run-v1",
  "target": "wasm32-wasip1",
  "backend": "ros2",
  "distribution": "humble",
  "runtime": "uwvm2-ros",
  "runtime_sha256": null,
  "runtime_arguments": [
    "--runtime-aot",
    "--wasm-set-main-module-name",
    "main"
  ],
  "application_arguments": [],
  "state": "EXPLICITLY_FILL_EXACT_QUALIFIED_RUNTIME_IDENTITY",
  "wasi_policy": {
    "format": "uwvm-sdk-wasip1-policy-v3",
    "modules": {
      "main": {
        "enabled": true,
        "grants": [
          "proc-exit",
          "args",
          "stdout.write",
          "stderr.write",
          "stdio.metadata"
        ],
        "interfaces": {
          "args_get": "allow",
          "args_sizes_get": "allow",
          "fd_close": "allow",
          "fd_fdstat_get": "allow",
          "fd_read": "allow",
          "fd_seek": "allow",
          "fd_write": "allow",
          "proc_exit": "allow"
        }
      }
    }
  }
}

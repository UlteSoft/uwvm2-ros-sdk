        "math": {
          "ros_enabled": false,
          "grants": [],
          "wasi_grants": [],
          "wasi_enabled": true,
          "wasi_interfaces": {
            "args_get": "allow",
            "args_sizes_get": "allow",
            "clock_time_get": "allow",
            "fd_write": "allow"
          },
          "ros_interfaces": {}
        },
        "math_peer": {
          "ros_enabled": false,
          "grants": [],
          "wasi_grants": [],
          "wasi_enabled": true,
          "wasi_interfaces": {
            "args_get": "allow",
            "args_sizes_get": "allow",
            "clock_time_get": "allow",
            "fd_write": "allow"
          },
          "ros_interfaces": {}
        }
      }
    }
  }

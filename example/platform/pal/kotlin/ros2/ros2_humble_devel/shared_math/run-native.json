{
  "format": "uwvm-native-ros-run-v4",
  "runtime": "/opt/uwvm/bin/uwvm2-ros",
  "gateway": "/opt/uwvm/bin/uwvm-ros2-gateway",
  "backend": "ros2",
  "distribution": "humble",
  "connection": {},
  "runtime_features": [],
  "execution_timeout_seconds": 30,
  "examples": {
    "shared_math": {
      "arguments": [],
      "main_module": "main",
      "preloads": [
        {
          "module": "math",
          "path": "build/targets/6d617468/math.wasm",
          "attribute": "none"

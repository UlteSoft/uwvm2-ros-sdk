{
  "format": "uwvm-sdk-local-finite-ros-test-v1",
  "ros_namespace": "ros2",
  "runtime": {
    "executable": "/absolute/path/to/uwvm2-ros",
    "sha256": "REPLACE_WITH_EXECUTABLE_SHA256",
    "source_identity": "REPLACE_WITH_SOURCE_IDENTITY",
    "llvm_jit_policy": "debug"
  },
  "limits": {
    "memory_bytes": 68719476736,
    "swap_bytes": 0,
    "timeout_seconds": 1800,
    "output_bytes": 2097152
  },
  "wasi_policy": {
    "format": "uwvm-sdk-wasip1-policy-v2",
    "modules": {
      "main": {
        "enabled": true,
        "grants": [
          "proc-exit",
          "args",
          "environ",
          "stdout.write",
          "stderr.write",
          "stdio.metadata"
        ]
      }
    }
  }
}

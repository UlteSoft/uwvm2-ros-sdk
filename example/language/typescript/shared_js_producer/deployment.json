{
  "format": "uwvm-ros-command-run-v1",
  "target": "wasm32-wasip1",
  "backend": "wasi",
  "runtime": "uwvm2-ros",
  "runtime_arguments": [
    "--wasm-set-main-module-name",
    "main",
    "--wasm-preload-library",
    "build/targets/616c676f726974686d/algorithm.wasm",
    "algorithm"
  ],
  "application_arguments": [],
  "wasi_policy": {
    "format": "uwvm-sdk-wasip1-policy-v3",
    "modules": {
      "main": {
        "enabled": true,
        "grants": [],
        "interfaces": {
          "args_get": "allow",
          "args_sizes_get": "allow",
          "clock_time_get": "allow",
          "fd_close": "allow",
          "fd_fdstat_get": "allow",
          "fd_read": "allow",
          "fd_seek": "allow",
          "fd_write": "allow",
          "proc_exit": "allow"
        }
      },
      "algorithm": {
        "enabled": true,
        "grants": [],
        "interfaces": {
          "clock_time_get": "allow",
          "fd_close": "allow",
          "fd_seek": "allow",
          "fd_write": "allow"
        }
      }
    }
  }
}

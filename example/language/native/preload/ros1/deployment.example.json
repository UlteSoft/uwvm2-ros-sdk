{
  "format": "uwvm-native-ros-run-v3",
  "runtime": "/opt/uwvm/bin/uwvm2-ros",
  "gateway": "/opt/uwvm/bin/uwvm-ros1-gateway",
  "backend": "ros1",
  "distribution": "noetic",
  "connection": {
    "master-uri": "http://127.0.0.1:11311",
    "node-name": "uwvm_library_gateway",
    "namespace": "/uwvm_library",
    "advertise-host": "127.0.0.1",
    "transport": "tcpros"
  },
  "examples": {
    "preload_pipeline": {
      "arguments": [
        "9",
        "granted"
      ],
      "main_module": "main",
      "preloads": [
        {
          "module": "io",
          "path": "build/io/io.wasm",
          "attribute": "copy"
        },
        {
          "module": "algorithm",
          "path": "build/algorithm/algorithm.wasm",
          "attribute": "copy"
        },
        {
          "module": "ros_comm",
          "path": "build/ros_comm/ros_comm.wasm",
          "attribute": "copy"
        }
      ],
      "modules": {
        "main": {
          "ros_enabled": true,
          "grants": [],
          "wasi_grants": [
            "args",
            "proc-exit"
          ],
          "wasi_enabled": true
        },
        "io": {
          "ros_enabled": true,
          "grants": [],
          "wasi_grants": [
            "stdout.write",
            "stdio.metadata"
          ],
          "wasi_enabled": true
        },
        "algorithm": {
          "ros_enabled": true,
          "grants": [],
          "wasi_grants": [],
          "wasi_enabled": true
        },
        "ros_comm": {
          "ros_enabled": true,
          "wasi_grants": [
            "realtime-timer"
          ],
          "call_boundary": "module-exports",
          "grants": [
            {
              "alias": "library_pub",
              "operation": "topic.publish",
              "resource": "/uwvm_library/outgoing",
              "type": "std_msgs/String",
              "identity": "992ce8a1687cec8c8bd883ec73ca41d1",
              "limits": {
                "max-rate-hz": "100",
                "burst": "8",
                "max-bytes-per-second": "1048576",
                "validator": "none",
                "audit": "allow-and-deny",
                "audit-max-rate-hz": "100",
                "audit-burst": "100",
                "audit-max-records": "10000",
                "audit-max-bytes": "1048576",
                "max-message-bytes": "256",
                "max-queue-bytes": "2048",
                "overflow-policy": "reject",
                "max-publishers": "1",
                "queue-depth": "8",
                "transport": "tcpros",
                "latch": "false"
              }
            }
          ],
          "wasi_enabled": true
        }
      }
    }
  },
  "runtime_features": [],
  "execution_timeout_seconds": 30
}

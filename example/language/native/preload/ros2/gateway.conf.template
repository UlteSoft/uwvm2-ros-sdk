backend ros2
worker-uid @WORKER_UID@
worker-pid @WORKER_PID@
socket /tmp/uwvm-library.sock
timeout-ms 10000
max-sessions 16
audit-max-records-per-second 100
audit-max-records 10000
audit-max-bytes 1048576
connection node-name uwvm_library_gateway
connection namespace /uwvm_library
connection domain-id 149
connection rmw-implementation rmw_fastrtps_cpp
connection security-mode disabled-test
connection keystore not-applicable
connection enclave not-applicable
grant library_pub topic.publish /uwvm_library/outgoing std_msgs/msg/String RIHS01_df668c740482bbd48fb39d76a70dfd4bd59db1288021743503259e948f6b1a18
set library_pub max-rate-hz 100
set library_pub burst 8
set library_pub max-bytes-per-second 1048576
set library_pub validator none
set library_pub audit allow-and-deny
set library_pub audit-max-rate-hz 100
set library_pub audit-burst 100
set library_pub audit-max-records 10000
set library_pub audit-max-bytes 1048576
set library_pub max-message-bytes 256
set library_pub max-queue-bytes 2048
set library_pub overflow-policy drop-oldest
set library_pub max-publishers 1
set library_pub qos.reliability reliable
set library_pub qos.durability volatile
set library_pub qos.history keep-last
set library_pub qos.depth 8
set library_pub qos.deadline infinite
set library_pub qos.lifespan infinite
set library_pub qos.liveliness automatic
set library_pub qos.liveliness-lease-duration infinite
set library_pub max-inflight 1

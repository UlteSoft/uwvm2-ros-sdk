{
  "format": "uwvm-sdk-local-finite-wasi-test-v1",
  "runtime": {
    "executable": "/absolute/path/to/uwvm2-ros",
    "sha256": "REPLACE_WITH_ACTUAL_BINARY_SHA256",
    "source_identity": "REPLACE_WITH_VERIFIED_SOURCE_IDENTITY"
  },
  "limits": {
    "memory_bytes": 68719476736,
    "swap_bytes": 0,
    "timeout_seconds": 30,
    "output_bytes": 2097152
  },
  "wasi_policy": {
    "format": "uwvm-sdk-wasip1-policy-v3",
    "modules": {
      "main": {
        "enabled": true,
        "grants": [
          "stdout.write",
          "stdio.metadata",
          "proc-exit"
        ],
        "interfaces": {
          "fd_close": "allow",
          "fd_fdstat_get": "allow",
          "fd_seek": "allow",
          "fd_write": "allow",
          "proc_exit": "allow"
        }
      }
    }
  }
}

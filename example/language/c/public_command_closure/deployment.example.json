{
  "format": "uwvm-ros-command-run-v1",
  "target": "wasm32-wasip1",
  "backend": "wasi",
  "runtime": "uwvm2-ros",
  "runtime_arguments": [
    "--runtime-aot",
    "--wasm-set-main-module-name",
    "main"
  ],
  "wasi_policy": {
    "format": "uwvm-sdk-wasip1-policy-v2",
    "modules": {
      "main": {
        "enabled": true,
        "grants": [
          "stdout.write",
          "stdio.metadata",
          "proc-exit"
        ]
      }
    }
  },
  "application_arguments": []
}

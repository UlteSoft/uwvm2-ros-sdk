{
  "format": "uwvm-ros-command-run-v1",
  "target": "wasm32-wasip1",
  "backend": "wasi",
  "runtime": "uwvm2-ros",
  "runtime_arguments": [
    "--runtime-aot",
    "--wasm-set-main-module-name",
    "main"
  ],
  "wasi_policy": {
    "format": "uwvm-sdk-wasip1-policy-v3",
    "modules": {
      "main": {
        "enabled": true,
        "grants": [
          "stdout.write",
          "stdio.metadata",
          "proc-exit"
        ],
        "interfaces": {
          "fd_close": "allow",
          "fd_fdstat_get": "allow",
          "fd_seek": "allow",
          "fd_write": "allow",
          "proc_exit": "allow"
        }
      }
    }
  },
  "application_arguments": []
}

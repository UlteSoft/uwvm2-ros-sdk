+package wasm
+
+import (
+	"cmd/internal/obj"
+	"encoding/json"
+	"testing"
+)
+
+func TestSourceRelocationByteOffsets(t *testing.T) {
+	rows := []obj.WasmSourceLine{{Offset: 2}, {Offset: 4}, {Offset: 9}}
+	if !relocateSourceLines(rows, []wasmInsertion{{3, 2}, {4, 3}, {4, 1}}, 15) {
+		t.Fatal("valid relocation rejected")
+	}
+	for i, want := range []uint64{2, 10, 15} {
+		if rows[i].Offset != want {
+			t.Fatalf("row%d got%d want%d", i, rows[i].Offset, want)
+		}
+	}
+	if relocateSourceLines([]obj.WasmSourceLine{{Offset: 5}}, []wasmInsertion{{4, 9}}, 6) {
+		t.Fatal("out-of-body mapping accepted")
+	}
+	if relocateSourceLines([]obj.WasmSourceLine{{Offset: 2}, {Offset: 1}}, nil, 3) {
+		t.Fatal("decreasing offsets accepted")
+	}
+	if relocateSourceLines([]obj.WasmSourceLine{{Offset: 1}}, []wasmInsertion{{0, ^uint64(0)}, {0, 1}}, 3) {
+		t.Fatal("overflow accepted")
+	}
+}
+
+func TestSourceMapExactCoordinatesAndBoundaries(t *testing.T) {
+	data := sourceMapJSON([]*wasmFunc{
+		{CodeOffset: 20, Code: make([]byte, 10), SourceLines: []obj.WasmSourceLine{
+			{Offset: 2, File: "/app/main.go", Line: 8, Column: 5},
+			{Offset: 5, File: "/app/main.go", Line: 9, Column: 2},
+			{Offset: 8},
+		}},
+		{CodeOffset: 40, Code: make([]byte, 3)},
+	})
+	var got struct {
+		Version  int
+		Sources  []string
+		Mappings string
+	}
+	if err := json.Unmarshal(data, &got); err != nil {
+		t.Fatal(err)
+	}
+	// 22 -> line7 column4; 25 -> line8 column1; 28 unmapped; 30 unmapped.
+	const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
+	var values [][]int64
+	var row []int64
+	var number uint64
+	var shift uint
+	for _, c := range got.Mappings {
+		if c == ',' {
+			values = append(values, row)
+			row = nil
+			continue
+		}
+		digit := -1
+		for i, r := range alphabet {
+			if r == c {
+				digit = i
+				break
+			}
+		}
+		if digit < 0 {
+			t.Fatal("bad digit")
+		}
+		number |= uint64(digit&31) << shift
+		if digit&32 != 0 {
+			shift += 5
+			continue
+		}
+		v := int64(number >> 1)
+		if number&1 != 0 {
+			v = -v
+		}
+		row = append(row, v)
+		number = 0
+		shift = 0
+	}
+	values = append(values, row)
+	want := [][]int64{{22, 0, 7, 4}, {3, 0, 1, -3}, {3}, {2}}
+	if len(values) != len(want) {
+		t.Fatalf("%v", values)
+	}
+	for i := range want {
+		if len(values[i]) != len(want[i]) {
+			t.Fatalf("%v", values)
+		}
+		for j := range want[i] {
+			if values[i][j] != want[i][j] {
+				t.Fatalf("%v", values)
+			}
+		}
+	}
+	if got.Version != 3 || len(got.Sources) != 1 || got.Sources[0] != "/app/main.go" {
+		t.Fatalf("%s", data)
+	}
+	if sourceMapJSON([]*wasmFunc{{CodeOffset: 1, Code: make([]byte, 2)}}) != nil {
+		t.Fatal("empty metadata emitted")
+	}
+}

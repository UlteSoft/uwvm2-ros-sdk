@@ -0,0 +1,144 @@
+package wasm
+
+import (
+	"cmd/internal/obj"
+	"cmd/link/internal/ld"
+	"cmd/link/internal/loader"
+	"encoding/json"
+	"strings"
+)
+
+type wasmInsertion struct{ offset, size uint64 }
+
+// Relocations insert bytes into the assembler stream; no virtual PC arithmetic
+// participates in this translation. Multiple insertions at an offset all apply.
+func relocateSourceLines(rows []obj.WasmSourceLine, inserted []wasmInsertion, size uint64) bool {
+	for i, item := range inserted {
+		if item.offset > size || (i != 0 && item.offset < inserted[i-1].offset) {
+			return false
+		}
+	}
+	var delta, previous uint64
+	at := 0
+	for i := range rows {
+		raw := rows[i].Offset
+		if i != 0 && raw < previous {
+			return false
+		}
+		previous = raw
+		for at < len(inserted) && inserted[at].offset <= raw {
+			if ^uint64(0)-delta < inserted[at].size {
+				return false
+			}
+			delta += inserted[at].size
+			at++
+		}
+		if raw > size || delta > size-raw {
+			return false
+		}
+		rows[i].Offset = raw + delta
+	}
+	return true
+}
+
+func readWasmSourceLines(ctxt *ld.Link, ldr *loader.Loader, fn loader.Sym, inserted []wasmInsertion, size int) []obj.WasmSourceLine {
+	s := ldr.WasmSourceMapSym(fn)
+	if s == 0 {
+		return nil
+	}
+	var rows []obj.WasmSourceLine
+	if err := json.Unmarshal(ldr.Data(s), &rows); err != nil || !relocateSourceLines(rows, inserted, uint64(size)) {
+		ldr.Errorf(fn, "invalid WebAssembly source byte positions")
+		return nil
+	}
+	return rows
+}
+
+func sourceVLQ(b *strings.Builder, value int64) {
+	const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
+	n := uint64(value) << 1
+	if value < 0 {
+		n = uint64(-value)<<1 | 1
+	}
+	for {
+		digit := n & 31
+		n >>= 5
+		if n != 0 {
+			digit |= 32
+		}
+		b.WriteByte(alphabet[digit])
+		if n == 0 {
+			return
+		}
+	}
+}
+
+func sourceMapJSON(fns []*wasmFunc) []byte {
+	sources := []string{}
+	ids := make(map[string]int64)
+	var mapping strings.Builder
+	var generated, source, line, column int64
+	emit := func(offset uint64, row *obj.WasmSourceLine) {
+		if mapping.Len() != 0 {
+			mapping.WriteByte(',')
+		}
+		sourceVLQ(&mapping, int64(offset)-generated)
+		generated = int64(offset)
+		if row == nil || row.File == "" || row.Line == 0 {
+			return
+		}
+		id, exists := ids[row.File]
+		if !exists {
+			id = int64(len(sources))
+			ids[row.File] = id
+			sources = append(sources, row.File)
+		}
+		sourceVLQ(&mapping, id-source)
+		source = id
+		nextLine := int64(row.Line) - 1
+		sourceVLQ(&mapping, nextLine-line)
+		line = nextLine
+		nextColumn := int64(row.Column)
+		if nextColumn != 0 {
+			nextColumn--
+		}
+		sourceVLQ(&mapping, nextColumn-column)
+		column = nextColumn
+	}
+	for _, fn := range fns {
+		if len(fn.SourceLines) == 0 {
+			continue
+		}
+		for i := range fn.SourceLines {
+			row := &fn.SourceLines[i]
+			emit(fn.CodeOffset+row.Offset, row)
+		}
+		// End each mapped function explicitly, so metadata never bleeds into the
+		// following body, local declarations or module data.
+		emit(fn.CodeOffset+uint64(len(fn.Code)), nil)
+	}
+	if len(sources) == 0 {
+		return nil
+	}
+	data, err := json.Marshal(struct {
+		Version  int      `json:"version"`
+		Sources  []string `json:"sources"`
+		Names    []string `json:"names"`
+		Mappings string   `json:"mappings"`
+	}{3, sources, []string{}, mapping.String()})
+	if err != nil {
+		panic(err)
+	}
+	return data
+}
+
+func writeWasmSourceMap(ctxt *ld.Link, fns []*wasmFunc) {
+	data := sourceMapJSON(fns)
+	if data == nil {
+		return
+	}
+	offset := writeSecHeader(ctxt, sectionCustom)
+	writeName(ctxt.Out, ".debug_source_map")
+	ctxt.Out.Write(data)
+	writeSecSize(ctxt, offset)
+}

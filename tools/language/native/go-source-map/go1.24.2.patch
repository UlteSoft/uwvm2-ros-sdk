+package obj
+
+import (
+	"cmd/internal/objabi"
+	"encoding/json"
+)
+
+// WasmSourceLine records a real encoded instruction offset, never a Go virtual PC.
+// An empty File marks an unmapped instruction range.
+type WasmSourceLine struct {
+	Offset uint64
+	File   string
+	Line   uint32
+	Column uint32
+}
+
+func NewWasmSourceMap(lines []WasmSourceLine) *LSym {
+	data, err := json.Marshal(lines)
+	if err != nil {
+		panic(err)
+	}
+	return &LSym{Type: objabi.SDATA, P: data, Size: int64(len(data))}
+}

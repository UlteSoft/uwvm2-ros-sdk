+// --- 0xfc20: memtag.status ---
+// CHECK-LABEL: define {{.*}} @test_status()
+// W32: call i32 @llvm.wasm.memtag.status.i32(i32 0)
+// W64: call i64 @llvm.wasm.memtag.status.i64(i32 0)
+size_t test_status() {
+  return __builtin_wasm_memtag_status(0);
+}
+

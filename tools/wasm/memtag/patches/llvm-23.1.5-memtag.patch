new file mode 100644
index 0000000000..8c2f57ae18
--- /dev/null
+++ b/lld/test/wasm/memtag-tls.s
@@ -0,0 +1,49 @@
+# RUN: llvm-mc -filetype=obj -triple=wasm32-unknown-unknown %s -o %t.o
+# RUN: wasm-ld --shared-memory --max-memory=131072 --no-entry --no-gc-sections %t.o -o %t.wasm
+# RUN: llvm-objdump -d --no-show-raw-insn --no-leading-addr %t.wasm | FileCheck %s
+
+# Per-thread initialization must tag the resolved TLS base plus each symbol's
+# offset. randomstore (not randomstorez) preserves copied initializer bytes.
+.globaltype __tls_base, i32
+.memtag first
+.section .tdata.first,"T",@
+.globl first
+.p2align 4
+first:
+.int32 37
+.skip 12
+.size first, 16
+
+.memtag second
+.section .tbss.second,"T",@
+.globl second
+.p2align 4
+second:
+.skip 32
+.size second, 32
+
+.section .custom_section.target_features,"",@
+.int8 2
+.int8 43
+.int8 7
+.ascii "atomics"
+.int8 43
+.int8 11
+.ascii "bulk-memory"
+
+# CHECK-LABEL: <__wasm_init_tls>:
+# CHECK: memory.init
+# CHECK: local.get 0
+# CHECK-NEXT: i32.const 0
+# CHECK-NEXT: i32.add
+# CHECK-NEXT: i32.const 16
+# CHECK-NEXT: memtag.randomstore 0
+# CHECK-NEXT: drop
+# CHECK-NEXT: local.get 0
+# CHECK-NEXT: i32.const 16
+# CHECK-NEXT: i32.add
+# CHECK-NEXT: i32.const 32
+# CHECK-NEXT: memtag.randomstore 0
+# CHECK-NEXT: drop
+# CHECK-NOT: memtag.randomstorez
+# CHECK: end

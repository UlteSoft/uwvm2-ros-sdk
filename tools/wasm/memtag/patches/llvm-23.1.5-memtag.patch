index 0000000000..2180835a91
--- /dev/null
+++ b/llvm/test/CodeGen/WebAssembly/memtag-dynamic-alloca.ll
@@ -0,0 +1,43 @@
+; RUN: llc < %s -verify-each -stop-after=wasm-stack-tagging | FileCheck %s
+; RUN: llc < %s -mtriple=wasm64-unknown-unknown -verify-each -stop-after=wasm-stack-tagging | FileCheck %s
+; RUN: llc < %s -verify-each -filetype=obj -o /dev/null
+; RUN: llc < %s -mtriple=wasm64-unknown-unknown -verify-each -filetype=obj -o /dev/null
+target triple = "wasm32-unknown-unknown"
+
+declare void @use(ptr)
+declare ptr @llvm.stacksave.p0()
+declare void @llvm.stackrestore.p0(ptr)
+
+; Each dynamic object is padded and tagged after checked size arithmetic. Both
+; block stackrestore and function return retire discarded ranges, so loops do
+; not require a bounded allocation list. Saved stack positions are raw pointers.
+; CHECK-LABEL: define void @dynamic(
+; CHECK: %memtag.dynamic.base = call ptr @llvm.stacksave.p0()
+; CHECK: call { i{{32|64}}, i1 } @llvm.umul.with.overflow
+; CHECK: call { i{{32|64}}, i1 } @llvm.uadd.with.overflow
+; CHECK: call void @llvm.trap()
+; CHECK: %object.raw = alloca i8, i{{32|64}} %memtag.dynamic.size, align 16
+; CHECK: %object.tag = call ptr @llvm.wasm.memtag.randomstore
+; CHECK: call void @use(ptr %object.tag)
+; CHECK: %memtag.dynamic.current = call ptr @llvm.stacksave.p0()
+; CHECK: call void @llvm.wasm.memtag.store
+; CHECK: call void @llvm.stackrestore.p0(ptr %saved)
+; CHECK: call void @llvm.wasm.memtag.store
+; CHECK: ret void
+define void @dynamic(i64 %count) sanitize_memtag {
+entry:
+  %saved = call ptr @llvm.stacksave.p0()
+  %object = alloca i64, i64 %count, align 8
+  call void @use(ptr %object)
+  call void @llvm.stackrestore.p0(ptr %saved)
+  ret void
+}
+
+; CHECK-LABEL: define void @plain(
+; CHECK-NOT: @llvm.wasm.memtag
+; CHECK: ret void
+define void @plain(i64 %count) {
+  %object = alloca i64, i64 %count, align 8
+  call void @use(ptr %object)
+  ret void
+}
diff --git a/llvm/test/CodeGen/WebAssembly/memtag-global-external.ll b/llvm/test/CodeGen/WebAssembly/memtag-global-external.ll
new file mode 100644
index 0000000000..120bde1a5d
--- /dev/null
+++ b/llvm/test/CodeGen/WebAssembly/memtag-global-external.ll
@@ -0,0 +1,74 @@
+; RUN: llc < %s -verify-each -stop-after=WebAssembly-globals-tagging | FileCheck %s
+; RUN: llc < %s -verify-each -filetype=obj -o /dev/null
+target triple = "wasm32-unknown-unknown"
+@external_data = external global i32
+@external_tls = external thread_local global i32
+@__heap_end = external global i8
+@dummy = internal global ptr null, sanitize_memtag
+@weak_data = weak alias ptr, ptr @dummy
+@function_alias = weak alias void (), ptr @plain_function
+
+; Even a TU with no locally taggable definitions must repair external and weak
+; data references in instrumented functions after final symbol resolution.
+; CHECK-LABEL: define i32 @external_use(
+; CHECK: call ptr @llvm.wasm.memtag.load(i32 0, ptr @external_data)
+; CHECK: load volatile i32
+define i32 @external_use() sanitize_memtag {
+  %x = load volatile i32, ptr @external_data
+  ret i32 %x
+}
+; CHECK-LABEL: define ptr @alias_use(
+; CHECK: call ptr @llvm.wasm.memtag.load(i32 0, ptr @weak_data)
+; CHECK: load volatile ptr
+define ptr @alias_use() sanitize_memtag {
+  %x = load volatile ptr, ptr @weak_data
+  ret ptr %x
+}
+; Do not introduce an extension into an uninstrumented external reference.
+; CHECK-LABEL: define i32 @uninstrumented(
+; CHECK-NOT: call ptr @llvm.wasm.memtag.load
+; CHECK: load volatile i32, ptr @external_data
+define i32 @uninstrumented() {
+  %x = load volatile i32, ptr @external_data
+  ret i32 %x
+}
+; Do not treat a function/table alias as a linear-memory pointer.
+; CHECK-LABEL: define ptr @function_pointer(
+; CHECK-NOT: call ptr @llvm.wasm.memtag.load
+; CHECK: ret ptr @function_alias
+define ptr @function_pointer() sanitize_memtag {
+  ret ptr @function_alias
+}
+define void @plain_function() { ret void }
+
+; Linker addresses and external data use a runtime in-range guard, avoiding an
+; invalid tag load when a symbol denotes one-past-the-end instead of an object.
+; CHECK-LABEL: define i32 @linker_address(
+; CHECK: [[STATUS:%.*]] = call i32 @llvm.wasm.memtag.status.i32(i32 0)
+; CHECK: [[ENABLED:%.*]] = icmp ne i32 [[STATUS]], 0
+; CHECK: br i1 [[ENABLED]], label %memtag.global.check, label %memtag.global.cont
+; CHECK: memtag.global.check:
+; CHECK: call i32 @llvm.wasm.memory.size.i32(i32 0)
+; CHECK: icmp ult
+; CHECK: br i1
+; CHECK: memtag.global.load:
+; CHECK: call ptr @llvm.wasm.memtag.load(i32 0, ptr @__heap_end)
+; CHECK: memtag.global.cont:
+; CHECK: phi ptr [ @__heap_end, %0 ],
+define i32 @linker_address() sanitize_memtag {
+  ret i32 ptrtoint (ptr @__heap_end to i32)
+}
+
+@optional_data = extern_weak global i32
+; Do not let a nonzero tag on address zero turn an absent weak symbol nonnull.
+; CHECK-LABEL: define i1 @weak_null(
+; CHECK: icmp ult
+; CHECK: [[NONNULL:%.*]] = icmp ne ptr @optional_data, null
+; CHECK: and i1 {{.*}}, [[NONNULL]]
+; CHECK: br i1
+; CHECK: call ptr @llvm.wasm.memtag.load(i32 0, ptr @optional_data)
+; CHECK: phi ptr [ @optional_data,
+define i1 @weak_null() sanitize_memtag {
+  %present = icmp ne ptr @optional_data, null
+  ret i1 %present
+}
diff --git a/llvm/test/CodeGen/WebAssembly/memtag-global-phi.ll b/llvm/test/CodeGen/WebAssembly/memtag-global-phi.ll
new file mode 100644
index 0000000000..0a5375f758
--- /dev/null
+++ b/llvm/test/CodeGen/WebAssembly/memtag-global-phi.ll
@@ -0,0 +1,57 @@
+; RUN: llc < %s -verify-each -stop-after=WebAssembly-globals-tagging | FileCheck %s
+; RUN: llc < %s -verify-each -filetype=obj -o /dev/null
+
+target triple = "wasm32-unknown-unknown"
+@arr = global [16 x i8] zeroinitializer, sanitize_memtag, align 16
+
+; Rewritten expressions belong to their incoming blocks, not the PHI block.
+; CHECK-LABEL: define ptr @phi_edges(
+; CHECK: entry:
+; CHECK: call ptr @llvm.wasm.memtag.load(i32 0, ptr @arr)
+; CHECK: left:
+; CHECK: getelementptr
+; CHECK: br label %join
+; CHECK: right:
+; CHECK: getelementptr
+; CHECK: br label %join
+; CHECK: join:
+; CHECK-NEXT: %a = phi ptr
+; CHECK-NEXT: %b = phi i32
+define ptr @phi_edges(i1 %cond) {
+entry:
+  br i1 %cond, label %left, label %right
+left:
+  br label %join
+right:
+  br label %join
+join:
+  %a = phi ptr [ getelementptr ([16 x i8], ptr @arr, i32 0, i32 1), %left ],
+               [ getelementptr ([16 x i8], ptr @arr, i32 0, i32 2), %right ]
+  %b = phi i32 [ 1, %left ], [ 2, %right ]
+  %result = getelementptr i8, ptr %a, i32 %b
+  ret ptr %result
+}
+
+; A loop backedge/critical edge must retain PHI grouping and dominance.
+; CHECK-LABEL: define ptr @loop(
+; CHECK: loop:
+; CHECK-NEXT: %p = phi ptr
+define ptr @loop(i1 %again) {
+entry:
+  br label %loop
+loop:
+  %p = phi ptr [ getelementptr ([16 x i8], ptr @arr, i32 0, i32 3), %entry ],
+               [ getelementptr ([16 x i8], ptr @arr, i32 0, i32 4), %loop ]
+  br i1 %again, label %loop, label %exit
+exit:
+  ret ptr %p
+}
+
+; Recursively expanded operands must precede their users.
+; CHECK-LABEL: define i32 @nested(
+; CHECK: call ptr @llvm.wasm.memtag.load(i32 0, ptr @arr)
+; CHECK: getelementptr
+; CHECK: ptrtoint
+define i32 @nested() {
+  ret i32 ptrtoint (ptr getelementptr ([16 x i8], ptr @arr, i32 0, i32 5) to i32)
+}
diff --git a/llvm/test/CodeGen/WebAssembly/memtag-globals.ll b/llvm/test/CodeGen/WebAssembly/memtag-globals.ll
new file mode 100644
index 0000000000..d02a6eac01
--- /dev/null
+++ b/llvm/test/CodeGen/WebAssembly/memtag-globals.ll
@@ -0,0 +1,76 @@
+; RUN: llc < %s -stop-after=WebAssembly-globals-tagging | FileCheck %s --check-prefix=IR
+; RUN: llc < %s -asm-verbose=false | FileCheck %s --check-prefix=ASM
+
+target triple = "wasm32-unknown-unknown"
+
+; Globals smaller than a tag granule are padded to 16 bytes and 16-byte aligned.
+; IR: @tagged = {{.*}}global { i32, [12 x i8] } { i32 42, [12 x i8] zeroinitializer }, sanitize_memtag, align 16
+@tagged = global i32 42, sanitize_memtag, align 4
+
+; Untagged globals are left alone.
+; IR: @plain = {{.*}}global i32 7
+@plain = global i32 7, align 4
+
+; Globals that are already granule-sized only get their alignment bumped.
+; IR: @arr = {{.*}}global [4 x i32] zeroinitializer, sanitize_memtag, align 16
+@arr = global [4 x i32] zeroinitializer, sanitize_memtag, align 4
+
+; Constant globals are not tagged; their metadata is dropped.
+; IR: @rodata = constant i32 5, align 4
+@rodata = constant i32 5, sanitize_memtag, align 4
+
+; TLS globals retain object-level tagging and granule alignment. LLD applies
+; a fresh allocation tag to each thread instance after copying its template.
+; IR: @tls = thread_local global { i32, [12 x i8] } { i32 9, [12 x i8] zeroinitializer }, sanitize_memtag, align 16
+@tls = thread_local global i32 9, sanitize_memtag, align 4
+
+; LLD materializes pointer tags in data relocations, including across TUs.
+; A global initializer no longer exempts its referenced allocation from MTE.
+; IR: @pointed_to = global { i32, [12 x i8] } { i32 11, [12 x i8] zeroinitializer }, sanitize_memtag, align 16
+@pointed_to = global i32 11, sanitize_memtag, align 4
+
+; @holder is not referenced by any initializer or alias, so it is tagged.
+; IR: @holder = {{.*}}global { ptr, [12 x i8] } { ptr @pointed_to, [12 x i8] zeroinitializer }, sanitize_memtag, align 16
+@holder = global ptr @pointed_to, sanitize_memtag, align 8
+
+; A single memtag.load is hoisted to the function entry for each tagged global,
+; and every use of the global goes through it.
+; IR-LABEL: define i32 @use(
+; IR:         %[[P:.*]] = call ptr @llvm.wasm.memtag.load(i32 0, ptr @tagged)
+; IR-NEXT:    %[[A:.*]] = load volatile i32, ptr %[[P]], align 4
+; IR-NEXT:    store volatile i32 %x, ptr %[[P]], align 4
+define i32 @use(i32 %x) {
+  %a = load volatile i32, ptr @tagged, align 4
+  store volatile i32 %x, ptr @tagged, align 4
+  ret i32 %a
+}
+
+; Constant expressions containing a tagged global are materialized as
+; instructions over the tagged pointer.
+; IR-LABEL: define ptr @gep(
+; IR:         %[[P:.*]] = call ptr @llvm.wasm.memtag.load(i32 0, ptr @arr)
+; IR-NEXT:    %[[G:.*]] = getelementptr inbounds [4 x i32], ptr %[[P]], i64 0, i64 2
+; IR-NEXT:    ret ptr %[[G]]
+define ptr @gep() {
+  ret ptr getelementptr inbounds ([4 x i32], ptr @arr, i64 0, i64 2)
+}
+
+; Untagged globals keep using their raw address.
+; IR-LABEL: define i32 @use_untagged(
+; IR-NOT:     memtag.load
+; IR:         %[[A:.*]] = load i32, ptr @plain
+; IR-NEXT:    ret i32 %[[A]]
+define i32 @use_untagged() {
+  %a = load i32, ptr @plain, align 4
+  ret i32 %a
+}
+
+; The data symbol carries the memtag symbol attribute and the padded size.
+; ASM:      memtag.load 0
+; ASM:      .memtag tagged
+; ASM:      .size tagged, 16
+; ASM:      .memtag arr
+; ASM:      .size arr, 16
+; ASM-NOT:  .memtag plain
+; ASM-NOT:  .memtag rodata
+; ASM:      .memtag pointed_to
diff --git a/llvm/test/CodeGen/WebAssembly/memtag-lifetime-edges.ll b/llvm/test/CodeGen/WebAssembly/memtag-lifetime-edges.ll
new file mode 100644
index 0000000000..9d6792766b
--- /dev/null
+++ b/llvm/test/CodeGen/WebAssembly/memtag-lifetime-edges.ll
@@ -0,0 +1,80 @@
+; RUN: llc < %s -stop-after=wasm-stack-tagging | FileCheck %s --check-prefix=IR
+; RUN: llc < %s -mtriple=wasm64-unknown-unknown -stop-after=wasm-stack-tagging | FileCheck %s --check-prefix=IR
+; RUN: llc < %s -mattr=+exception-handling -wasm-use-legacy-eh=false -asm-verbose=false | FileCheck %s --check-prefix=ASM
+
+target triple = "wasm32-unknown-unknown"
+@external = external global i32
+@weak = extern_weak global i8
+declare void @escape(ptr)
+declare i32 @__gxx_wasm_personality_v0(...)
+declare void @llvm.lifetime.start.p0(ptr)
+declare void @llvm.lifetime.end.p0(ptr)
+
+; External-global guards must keep static allocas in entry so the next pass
+; instruments them. More than one guard used to silently drop this coverage.
+; IR-LABEL: define i32 @external_stack(
+; IR: %a = alloca [32 x i8], align 16
+; IR: call ptr @llvm.wasm.memtag.randomstore
+; IR: call void @escape(ptr %a.tag)
+define i32 @external_stack() sanitize_memtag {
+entry:
+  %a = alloca [32 x i8], align 1
+  call void @escape(ptr %a)
+  %x = load volatile i32, ptr @external
+  %y = icmp eq ptr @weak, null
+  %z = zext i1 %y to i32
+  %r = add i32 %x, %z
+  ret i32 %r
+}
+
+; Even a combined tag/store needs retirement on the path that bypasses the
+; single explicit lifetime.end.
+; IR-LABEL: define void @early_exit(
+; IR: early:
+; IR-NEXT: call void @llvm.wasm.memtag.store
+; IR-NEXT: ret void
+; IR: normal:
+; IR-NEXT: call void @llvm.wasm.memtag.store
+; IR: ret void
+define void @early_exit(i1 %exit_early) sanitize_memtag {
+entry:
+  %a = alloca [32 x i8], align 16
+  call void @llvm.lifetime.start.p0(ptr %a)
+  call void @escape(ptr %a)
+  br i1 %exit_early, label %early, label %normal
+early:
+  ret void
+normal:
+  call void @llvm.lifetime.end.p0(ptr %a)
+  ret void
+}
+
+; A cleanup within the same function must not retire live stack storage.
+; IR-LABEL: define void @internal_cleanup(
+; IR: inner:
+; IR: call void @escape(ptr %a.tag)
+; IR-NOT: llvm.wasm.memtag.store
+; IR: cleanupret from %inner.pad unwind label %outer
+; IR: outer:
+; IR: call void @escape(ptr %a.tag)
+; IR-NEXT: call void @llvm.wasm.memtag.store
+; IR-NEXT: cleanupret from %outer.pad unwind to caller
+; ASM-LABEL: internal_cleanup:
+; ASM: global.get __stack_pointer
+; ASM: memtag.store 0
+; ASM: global.set __stack_pointer
+define void @internal_cleanup() sanitize_memtag personality ptr @__gxx_wasm_personality_v0 {
+entry:
+  %a = alloca [32 x i8], align 16
+  invoke void @escape(ptr %a) to label %done unwind label %inner
+done:
+  ret void
+inner:
+  %inner.pad = cleanuppad within none []
+  call void @escape(ptr %a) [ "funclet"(token %inner.pad) ]
+  cleanupret from %inner.pad unwind label %outer
+outer:
+  %outer.pad = cleanuppad within none []
+  call void @escape(ptr %a) [ "funclet"(token %outer.pad) ]
+  cleanupret from %outer.pad unwind to caller
+}
diff --git a/llvm/test/CodeGen/WebAssembly/memtag-proven-safe.ll b/llvm/test/CodeGen/WebAssembly/memtag-proven-safe.ll
new file mode 100644
index 0000000000..bf0e520f8d
--- /dev/null
+++ b/llvm/test/CodeGen/WebAssembly/memtag-proven-safe.ll
@@ -0,0 +1,170 @@
+; RUN: llc < %s -mattr=+memtag,+atomics -stop-after=wasm-stack-tagging | FileCheck %s
+; RUN: llc < %s -mtriple=wasm64-unknown-unknown -mattr=+memtag,+atomics -stop-after=wasm-stack-tagging | FileCheck %s
+
+; A proof must include bounds, lifetime and every reachable use. Safe stack
+; objects retain ordinary Wasm memory access semantics without tag maintenance.
+; Unknown callees, escaping pointers and incomplete range proofs stay tagged.
+
+; CHECK-LABEL: define {{.*}}@safe_constant(
+; CHECK-NOT: llvm.wasm.memtag.
+; CHECK: ret i32
+
+; CHECK-LABEL: define {{.*}}@safe_masked(
+; CHECK-NOT: llvm.wasm.memtag.
+; CHECK: ret i32
+
+; CHECK-LABEL: define {{.*}}@safe_atomic(
+; CHECK-NOT: llvm.wasm.memtag.
+; CHECK: ret i32
+
+; CHECK-LABEL: define {{.*}}@bounded_callee(
+; CHECK: ret i32
+
+; CHECK-LABEL: define {{.*}}@safe_known_call(
+; CHECK-NOT: llvm.wasm.memtag.
+; CHECK: ret i32
+
+; CHECK-LABEL: define {{.*}}@safe_bulk(
+; CHECK-NOT: llvm.wasm.memtag.
+; CHECK: ret i32
+
+; CHECK-LABEL: define {{.*}}@unsafe_index(
+; CHECK: %buf.tag = call ptr @llvm.wasm.memtag.random
+; CHECK: call void @llvm.wasm.memtag.store
+
+; CHECK-LABEL: define {{.*}}@unsafe_oob(
+; CHECK: %buf.tag = call ptr @llvm.wasm.memtag.random
+; CHECK: call void @llvm.wasm.memtag.store
+
+; CHECK-LABEL: define {{.*}}@unsafe_after_lifetime(
+; CHECK: %buf.tag = call ptr @llvm.wasm.memtag.random
+; CHECK: call void @llvm.wasm.memtag.store
+
+; CHECK-LABEL: define {{.*}}@unsafe_before_lifetime(
+; CHECK: %buf.tag = call ptr @llvm.wasm.memtag.random
+; CHECK: call void @llvm.wasm.memtag.store
+
+; CHECK-LABEL: define {{.*}}@unsafe_unknown_call(
+; CHECK: %buf.tag = call ptr @llvm.wasm.memtag.random
+; CHECK: call void @llvm.wasm.memtag.store
+
+; CHECK-LABEL: define {{.*}}@unsafe_indirect_call(
+; CHECK: %buf.tag = call ptr @llvm.wasm.memtag.random
+; CHECK: call void @llvm.wasm.memtag.store
+
+; CHECK-LABEL: define {{.*}}@unsafe_escape(
+; CHECK: %buf.tag = call ptr @llvm.wasm.memtag.random
+; CHECK: call void @llvm.wasm.memtag.store
+
+; CHECK-LABEL: define {{.*}}@unsafe_return(
+; CHECK: %buf.tag = call ptr @llvm.wasm.memtag.random
+; CHECK: call void @llvm.wasm.memtag.store
+target triple = "wasm32-unknown-unknown"
+@escaped = external global ptr
+declare void @unknown(ptr)
+declare void @llvm.lifetime.start.p0(ptr)
+declare void @llvm.lifetime.end.p0(ptr)
+declare void @llvm.memset.p0.i32(ptr, i8, i32, i1)
+
+define i32 @safe_constant() sanitize_memtag {
+entry:
+  %buf = alloca [32 x i8], align 16
+  %p = getelementptr i8, ptr %buf, i32 28
+  store volatile i32 42, ptr %p, align 4
+  %r = load volatile i32, ptr %p, align 4
+  ret i32 %r
+}
+define i32 @safe_masked(i32 %x) sanitize_memtag {
+entry:
+  %buf = alloca [32 x i8], align 16
+  %i = and i32 %x, 7
+  %p = getelementptr i32, ptr %buf, i32 %i
+  store volatile i32 42, ptr %p, align 4
+  %r = load volatile i32, ptr %p, align 4
+  ret i32 %r
+}
+define i32 @safe_atomic() sanitize_memtag {
+entry:
+  %buf = alloca [32 x i8], align 16
+  %p = getelementptr i8, ptr %buf, i32 28
+  store atomic i32 42, ptr %p seq_cst, align 4
+  %r = load atomic i32, ptr %p seq_cst, align 4
+  ret i32 %r
+}
+define internal i32 @bounded_callee(ptr %p) noinline {
+entry:
+  store volatile i32 42, ptr %p, align 4
+  %r = load volatile i32, ptr %p, align 4
+  ret i32 %r
+}
+define i32 @safe_known_call() sanitize_memtag {
+entry:
+  %buf = alloca [32 x i8], align 16
+  %p = getelementptr i8, ptr %buf, i32 28
+  %r = call i32 @bounded_callee(ptr %p)
+  ret i32 %r
+}
+define i32 @safe_bulk() sanitize_memtag {
+entry:
+  %buf = alloca [32 x i8], align 16
+  call void @llvm.memset.p0.i32(ptr %buf, i8 42, i32 32, i1 true)
+  %p = getelementptr i8, ptr %buf, i32 31
+  %r = load volatile i8, ptr %p
+  %z = zext i8 %r to i32
+  ret i32 %z
+}
+define i32 @unsafe_index(i32 %i) sanitize_memtag {
+entry:
+  %buf = alloca [32 x i8], align 16
+  %p = getelementptr i8, ptr %buf, i32 %i
+  %r = load volatile i32, ptr %p, align 1
+  ret i32 %r
+}
+define i32 @unsafe_oob() sanitize_memtag {
+entry:
+  %buf = alloca [32 x i8], align 16
+  %p = getelementptr i8, ptr %buf, i32 32
+  %r = load volatile i32, ptr %p, align 1
+  ret i32 %r
+}
+define i32 @unsafe_after_lifetime() sanitize_memtag {
+entry:
+  %buf = alloca [32 x i8], align 16
+  call void @llvm.lifetime.start.p0(ptr %buf)
+  store volatile i32 42, ptr %buf
+  call void @llvm.lifetime.end.p0(ptr %buf)
+  %r = load volatile i32, ptr %buf
+  ret i32 %r
+}
+define i32 @unsafe_before_lifetime() sanitize_memtag {
+entry:
+  %buf = alloca [32 x i8], align 16
+  %r = load volatile i32, ptr %buf
+  call void @llvm.lifetime.start.p0(ptr %buf)
+  store volatile i32 42, ptr %buf
+  call void @llvm.lifetime.end.p0(ptr %buf)
+  ret i32 %r
+}
+define void @unsafe_unknown_call() sanitize_memtag {
+entry:
+  %buf = alloca [32 x i8], align 16
+  call void @unknown(ptr %buf)
+  ret void
+}
+define void @unsafe_indirect_call(ptr %fn) sanitize_memtag {
+entry:
+  %buf = alloca [32 x i8], align 16
+  call void %fn(ptr %buf)
+  ret void
+}
+define void @unsafe_escape() sanitize_memtag {
+entry:
+  %buf = alloca [32 x i8], align 16
+  store ptr %buf, ptr @escaped
+  ret void
+}
+define ptr @unsafe_return() sanitize_memtag {
+entry:
+  %buf = alloca [32 x i8], align 16
+  ret ptr %buf
+}
diff --git a/llvm/test/CodeGen/WebAssembly/memtag-tls.ll b/llvm/test/CodeGen/WebAssembly/memtag-tls.ll
new file mode 100644
index 0000000000..87fc689be0
--- /dev/null
+++ b/llvm/test/CodeGen/WebAssembly/memtag-tls.ll
@@ -0,0 +1,36 @@
+; RUN: llc < %s -mattr=+atomics,+bulk-memory -verify-each -stop-after=WebAssembly-globals-tagging | FileCheck %s --check-prefix=IR
+; RUN: llc < %s -mattr=+atomics,+bulk-memory -verify-each | FileCheck %s --check-prefix=ASM
+; RUN: llc < %s -mattr=+atomics,+bulk-memory -verify-each -filetype=obj -o /dev/null
+
+target triple = "wasm32-unknown-wasip1-threads"
+@initialized = thread_local global i32 17, sanitize_memtag
+@zeroed = thread_local global [8 x i8] zeroinitializer, sanitize_memtag
+@foreign = external thread_local global i32
+
+declare ptr @llvm.threadlocal.address.p0(ptr)
+
+; Padding must preserve TLS storage and the resolved address must be retagged.
+; The symbol operand of llvm.threadlocal.address must remain a constant.
+; IR: @initialized = thread_local global { i32, [12 x i8] }
+; IR: @zeroed = thread_local global { [8 x i8], [8 x i8] }
+; IR-LABEL: define ptr @get_initialized(
+; IR: [[P:%.*]] = call ptr @llvm.threadlocal.address.p0(ptr @initialized)
+; IR-NEXT: [[T:%.*]] = call ptr @llvm.wasm.memtag.load(i32 0, ptr [[P]])
+; IR: ret ptr [[T]]
+define ptr @get_initialized() sanitize_memtag {
+  %p = call ptr @llvm.threadlocal.address.p0(ptr @initialized)
+  ret ptr %p
+}
+; IR-LABEL: define i32 @get_foreign(
+; IR: [[P:%.*]] = call ptr @llvm.threadlocal.address.p0(ptr @foreign)
+; IR-NEXT: [[T:%.*]] = call ptr @llvm.wasm.memtag.load(i32 0, ptr [[P]])
+; IR: load volatile i32, ptr [[T]]
+define i32 @get_foreign() sanitize_memtag {
+  %p = call ptr @llvm.threadlocal.address.p0(ptr @foreign)
+  %v = load volatile i32, ptr %p
+  ret i32 %v
+}
+; ASM-DAG: .memtag initialized

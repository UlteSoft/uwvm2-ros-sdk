# Pinned runtime binaries and upstream fixtures remain inputs unless dated.
!lib/**
!src/language/**/upstream/**

# Raw local runtime evidence stays on disk rather than in the published tree.
/share/platform/ros/runtime-evidence/

# This pinned rcutils testing header is upstream source, not CTest output.
# Keep it when core.ignorecase makes Testing/ match the lowercase source path.
!include/platform/ros/transplate/dependencies/rcutils/**/upstream/rcutils/testing/
!include/platform/ros/transplate/dependencies/rcutils/**/upstream/rcutils/testing/*.h

# Date-stamped paths stay local, including versioned inputs (repository policy).
# Match YYYYMMDD, YYYY-MM-DD, YYYY_MM_DD and YYYY.MM.DD anywhere in a name.
# Kept last so the upstream/source-input exceptions above do not override it.
*19[0-9][0-9]0[1-9]0[1-9]*
*19[0-9][0-9]0[1-9][12][0-9]*
*19[0-9][0-9]0[1-9]3[01]*
*19[0-9][0-9]1[0-2]0[1-9]*
*19[0-9][0-9]1[0-2][12][0-9]*
